{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install all dependencies",
      "type": "shell",
      "command": "pip install -r requirements.txt && pip install -r backend/requirements.txt && pip install -r streamlit_app/requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Run FastAPI backend",
      "type": "shell",
      "command": "uvicorn main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run Streamlit frontend",
      "type": "shell",
      "command": "streamlit run streamlit_app.py --server.port 8501",
      "options": { "cwd": "${workspaceFolder}/streamlit_app" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run Backend + Streamlit",
      "dependsOn": ["Run FastAPI backend", "Run Streamlit frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
